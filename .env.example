AI_WEB_SEARCH_ENABLED=true
AI_WEB_SEARCH_PROVIDER=tavily
AI_WEB_SEARCH_MAX_RESULTS=5
AI_WEB_SEARCH_TIMEOUT_MS=10000
AI_DEEP_RESEARCH_ENABLED=true
AI_RESEARCH_MAX_QUERIES=8
AI_RESEARCH_MAX_SOURCES=30
AI_RESEARCH_MAX_DEPTH=2

# CORS Allowed Origins (Comma separated)
