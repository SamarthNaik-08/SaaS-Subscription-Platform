# Live AI & Web Search Providers (Google Gemini, OpenAI, Tavily)
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
# Get a free Tavily Search key at: https://tavily.com
GEMINI_API_KEY=
OPENAI_API_KEY=
